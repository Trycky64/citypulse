# base API (si tu ajoutes un proxy, sinon laisser vide pour appels directs)
VITE_API_BASE="/"

# tuile de carte Leaflet
VITE_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# origine autorisée par l'API Node en développement ou en production
ALLOWED_ORIGIN="http://localhost:5173"

# (si tu utilises des clés API côté proxy, ne PAS les mettre ici côté front)
